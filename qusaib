        <b:includable id='main'>
  <b:if cond='data:title != &quot;&quot;'><h2><data:title/></h2></b:if>
  <div class='widget-content'>
    <b:if cond='data:mobile'>
      <select expr:id='data:widget.instanceId + &quot;_select&quot;'>
        <b:if cond='data:showPlaceholder'>
          <option disabled='disabled' hidden='hidden' value=''>
            <b:attr cond='!data:hasCurrentPage' name='selected' value='selected'/>
            <b:message name='messages.moveToPage'/>
          </option>
        </b:if>
        <b:loop values='data:links' var='link'>
          <option expr:value='data:link.href'>
            <b:attr cond='data:link.isCurrentPage' name='selected' value='selected'/>
            <data:link.title/>
          </option>
        </b:loop>
      </select>
      <span class='pagelist-arrow'>&amp;#9660;</span>
    <b:else/>
      <ul>
        <b:loop values='data:links' var='link'>
          <li>
            <b:class cond='data:link.isCurrentPage' name='selected'/>
            <a expr:href='data:link.href'><data:link.title/></a>
          </li>
        </b:loop>
      </ul>
    </b:if>
    <b:include name='quickedit'/>
  </div>
</b:includable>
      </b:widget>
    </b:section>

    <div class='news-ticker py-2 mb-8'>
        <div class='news-content'>
            <span class='px-4'>&#65021; شهر رمضان الذي أنزل فيه القرآن هدى للناس وبينات من الهدى والفرقان</span>
            <span class='px-4'>&#8226; تلاوة القرآن في رمضان لها فضل عظيم &#8226;</span>
            <span class='px-4'>&#65021; شهر رمضان الذي أنزل فيه القرآن هدى للناس وبينات من الهدى والفرقان</span>
        </div>
    </div>

    <main class='container mx-auto px-4 pb-12'>
        <div class='quran-section p-6 mb-8'>
            <div class='grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-6'>
                <div class='riwaya-card active bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>حفص</h3>
                    <p class='text-gray-600 mt-1'>عن عاصم</p>
                </div>
                <div class='riwaya-card bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>ورش</h3>
                    <p class='text-gray-600 mt-1'>عن نافع</p>
                </div>
                <div class='riwaya-card bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>قالون</h3>
                    <p class='text-gray-600 mt-1'>عن نافع</p>
                </div>
                <div class='riwaya-card bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>الدوري</h3>
                    <p class='text-gray-600 mt-1'>عن أبي عمرو</p>
                </div>
                <div class='riwaya-card bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>السوسي</h3>
                    <p class='text-gray-600 mt-1'>عن أبي عمرو</p>
                </div>
                <div class='riwaya-card bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>البزي</h3>
                    <p class='text-gray-600 mt-1'>عن ابن كثير</p>
                </div>
                <div class='riwaya-card bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>قنبل</h3>
                    <p class='text-gray-600 mt-1'>عن ابن كثير</p>
                </div>
                <div class='riwaya-card bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>ابن كثير</h3>
                    <p class='text-gray-600 mt-1'>عن عبد الله</p>
                </div>
                <div class='riwaya-card bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>ابن عامر</h3>
                    <p class='text-gray-600 mt-1'>عن يحيى</p>
                </div>
                <div class='riwaya-card bg-white p-4 rounded-lg shadow-md text-center cursor-pointer transition-all hover:shadow-lg'>
                    <h3 class='text-lg font-bold text-amber-600'>أبو جعفر</h3>
                    <p class='text-gray-600 mt-1'>عن يزيد</p>
                </div>
            </div>

            <!-- هنا سيتم عرض محتوى الرواية -->
            <div class='bg-white p-6 rounded-lg shadow mt-6' id='riwaya-content'>
                <p>اختر رواية لعرض المحتوى هنا.</p>
            </div>
        </div>

        <div class='text-center py-8'>
            <h2 class='text-2xl font-bold mb-4'>رياض الصالحين</h2>
            <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
                <div class='bg-white p-6 rounded-lg shadow'>
                    <h3 class='text-xl font-medium mb-3'>فضل الصيام</h3>
                    <p class='text-gray-700'>قال رسول الله ﷺ: &quot;من صام رمضان إيمانا&#1611; واحتسابا&#1611; غفر له ما تقدم من ذنبه&quot;</p>
                </div>
                <div class='bg-white p-6 rounded-lg shadow'>
                    <h3 class='text-xl font-medium mb-3'>فضل القيام</h3>
                    <p class='text-gray-700'>قال رسول الله ﷺ: &quot;من قام رمضان إيمانا&#1611; واحتسابا&#1611; غفر له ما تقدم من ذنبه&quot;</p>
                </div>
                <div class='bg-white p-6 rounded-lg shadow'>
                    <h3 class='text-xl font-medium mb-3'>فضل القرآن</h3>
                    <p class='text-gray-700'>قال رسول الله ﷺ: &quot;اقرؤوا القرآن فإنه يأتي شفيعا&#1611; لأصحابه يوم القيامة&quot;</p>
                </div>
            </div>
        </div>
    </main>

    <footer class='bg-gray-100 py-8 text-center'>
        <p class='text-gray-600'>&#169; 2023 عرب الرماضين - جميع الحقوق محفوظة</p>
    </footer>

    <script type='text/javascript'>
        // بيانات الروايات مع النص&#1548; رابط الصوت&#1548; ورابط إضافي
        const riwayaData = {
            &quot;حفص&quot;: {
                text: &quot;رواية حفص عن عاصم هي أشهر روايات القرآن الكريم وأكثرها انتشار&#1611;ا.&quot;,
                audio: &quot;audio/hafs.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D8%AD%D9%81%D8%B5_%D8%B9%D9%86_%D8%B9%D8%A7%D8%B5%D9%85&quot;
            },
            &quot;ورش&quot;: {
                text: &quot;رواية ورش عن نافع من الروايات المشهورة في قراءة القرآن.&quot;,
                audio: &quot;audio/warsh.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D9%88%D8%B1%D8%B4_%D8%B9%D9%86_%D9%86%D8%A7%D9%81%D8%B9&quot;
            },
            &quot;قالون&quot;: {
                text: &quot;رواية قالون عن نافع تتميز ببعض الفروق في النطق.&quot;,
                audio: &quot;audio/qalon.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D9%82%D8%A7%D9%84%D9%88%D9%86_%D8%B9%D9%86_%D9%86%D8%A7%D9%81%D8%B9&quot;
            },
            &quot;الدوري&quot;: {
                text: &quot;رواية الدوري عن أبي عمرو من القراءات العشر المعروفة.&quot;,
                audio: &quot;audio/douri.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D8%A7%D9%84%D8%AF%D9%88%D8%B1%D9%8A_%D8%B9%D9%86_%D8%A3%D8%A8%D9%8A_%D8%B9%D9%85%D8%B1%D9%88&quot;
            },
            &quot;السوسي&quot;: {
                text: &quot;رواية السوسي عن أبي عمرو تتميز بخصائص فريدة.&quot;,
                audio: &quot;audio/sousi.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D8%A7%D9%84%D8%B3%D9%88%D8%B3%D9%8A_%D8%B9%D9%86_%D8%A3%D8%A8%D9%8A_%D8%B9%D9%85%D8%B1%D9%88&quot;
            },
            &quot;البزي&quot;: {
                text: &quot;رواية البزي عن ابن كثير من القراءات المعروفة.&quot;,
                audio: &quot;audio/bazzi.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D8%A7%D9%84%D8%A8%D8%B2%D9%8A_%D8%B9%D9%86_%D8%A7%D8%A8%D9%86_%D9%83%D8%AB%D9%8A%D8%B1&quot;
            },
            &quot;قنبل&quot;: {
                text: &quot;رواية قنبل عن ابن كثير تتميز ببعض الخصائص.&quot;,
                audio: &quot;audio/qunbul.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D9%82%D9%86%D8%A8%D9%84_%D8%B9%D9%86_%D8%A7%D8%A8%D9%86_%D9%83%D8%AB%D9%8A%D8%B1&quot;
            },
            &quot;ابن كثير&quot;: {
                text: &quot;رواية ابن كثير عن عبد الله من القراءات المعروفة.&quot;,
                audio: &quot;audio/ibn_kathir.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D8%A7%D8%A8%D9%86_%D9%83%D8%AB%D9%8A%D8%B1_%D8%B9%D9%86_%D8%B9%D8%A8%D8%AF_%D8%A7%D9%84%D9%84%D9%87&quot;
            },
            &quot;ابن عامر&quot;: {
                text: &quot;رواية ابن عامر عن يحيى من القراءات العشر.&quot;,
                audio: &quot;audio/ibn_amer.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D8%A7%D8%A8%D9%86_%D8%B9%D8%A7%D9%85%D8%B1_%D8%B9%D9%86_%D9%8A%D8%AD%D9%8A%D9%89&quot;
            },
            &quot;أبو جعفر&quot;: {
                text: &quot;رواية أبو جعفر عن يزيد من القراءات المعروفة.&quot;,
                audio: &quot;audio/abu_jafar.mp3&quot;,
                link: &quot;https://ar.wikipedia.org/wiki/%D8%A3%D8%A8%D9%88_%D8%AC%D8%B9%D9%81%D8%B1_%D8%B9%D9%86_%D9%8A%D8%B2%D9%8A%D8%AF&quot;
            }
        };

        // وظيفة التفاعل مع البطاقات
        document.querySelectorAll(&#39;.riwaya-card&#39;).forEach(function(card) {
            card.addEventListener(&#39;click&#39;, function() {
                // إزالة التحديد من جميع البطاقات
                document.querySelectorAll(&#39;.riwaya-card&#39;).forEach(function(c) {
                    c.classList.remove(&#39;active&#39;, &#39;ring-2&#39;, &#39;ring-amber-500&#39;);
                });
                // إضافة التحديد للبطاقة المختارة
                card.classList.add(&#39;active&#39;, &#39;ring-2&#39;, &#39;ring-amber-500&#39;);

                // جلب اسم الرواية
                const riwayaName = card.querySelector(&#39;h3&#39;).textContent.trim();
                const contentDiv = document.getElementById(&#39;riwaya-content&#39;);

                if (riwayaData[riwayaName]) {
                    const data = riwayaData[riwayaName];
                    contentDiv.innerHTML = `
                        <h3 class='text-xl font-bold mb-2'>${riwayaName}</h3>
                        <p>${data.text}</p>
                        <audio class='w-full mt-4' controls='controls' preload='none'>
                            <source src='${data.audio}' type='audio/mpeg'/>
                            متصفحك لا يدعم تشغيل الصوت.
                        </audio>
                        <p class='mt-2'>
                            <a class='text-amber-600 hover:underline' href='${data.link}' target='_blank'>رابط المزيد</a>
                        </p>
                    `;
                } else {
                    contentDiv.innerHTML = `<p>لا يوجد محتوى متاح لهذه الرواية.</p>`;
                }
            });
        });

        // لتشغيل محتوى البطاقة الأولى تلقائيا&#1611; عند تحميل الصفحة
        window.addEventListener(&#39;DOMContentLoaded&#39;, function() {
            var firstCard = document.querySelector(&#39;.riwaya-card.active&#39;);
            if (firstCard) firstCard.click();
        });
    </script>
</body>
</html>
