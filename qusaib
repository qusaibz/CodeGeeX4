    <title>عرب الرماضين - القرآن الكريم</title>
    <link href='https://fonts.googleapis.com/css2?family=Tajawal&amp;display=swap' rel='stylesheet'/>
    <link crossorigin='anonymous' href='style.css' rel='stylesheet'/>
    <script src='https://cdn.tailwindcss.com' type='text/javascript'/>
    <b:skin><![CDATA[
        body {
            font-family: 'Tajawal', sans-serif;
            background-color: #f8f5f0;
            color: #2c3e50;
        }
        .header-title {
            font-size: 72px;
            color: #1a5276;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }
        .news-ticker {
            background-color: #1a5276;
            color: white;
            overflow: hidden;
            white-space: nowrap;
        }
        .news-content {
            display: inline-block;
            padding-left: 100%;
            animation: ticker 20s linear infinite;
        }
        @keyframes ticker {
            0% { transform: translateX(0); }
            100% { transform: translateX(-100%); }
        }
        .quran-section {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .riwaya-card {
            transition: all 0.3s ease;
        }
        .riwaya-card.active {
            background-color: #fef3c7;
            transform: translateY(-2px);
        }
    ]]></b:skin>
</head>
<body class='min-h-screen'>
    <header class='py-8 px-4 text-center'>
        <nav class='mb-6'>
            <ul class='flex justify-center space-x-8 text-lg'>
                <li><a class='hover:text-amber-600' href='#'>الرئيسية</a></li>
                <li><a class='hover:text-amber-600' href='#'>الروايات</a></li>
                <li><a class='hover:text-amber-600' href='#'>التفسير</a></li>
                <li><a class='hover:text-amber-600' href='#'>الأدعية</a></li>
            </ul>
        </nav>
        <h1 class='header-title font-bold'>عرب الرماضين</h1>
    </header>

    <!-- قسم بلوجر الرئيسي لعرض المشاركات أو الأدوات -->
    <b:section class='main-section' id='main' maxwidgets='1' name='Main' showaddelement='yes'>
